{
  "name": "dsh-soundcheck",
  "version": "0.8.1",
  "description": "Local music analysis for DSH (macOS + Windows): audio -> a short human-readable verdict",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "engine",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "darwin",
    "win32"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PUFFERFISHTNT/dsh-soundcheck.git"
  }
}
